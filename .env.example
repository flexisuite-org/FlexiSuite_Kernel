# === FlexiSuite Kernel (Rust) ===

# Database
DATABASE_URL=postgres://flexi:flexi@localhost:5432/flexisuite
DATABASE_MAX_CONNECTIONS=10

# Redis
REDIS_URL=redis://localhost:6379

# Auth (PASETO v4)
PASETO_SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRY_SECS=900
REFRESH_TOKEN_EXPIRY_SECS=604800

# Server
HOST=0.0.0.0
PORT=3000
RUST_LOG=info,kernel=debug

# Storage (S3/MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=flexisuite-components
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Component Builder
ESM_CDN_URL=https://esm.sh
