# === FlexiSuite Kernel (Rust) ===

# [REQUIRED] Database connection string
# Default for dev: postgres://flexi:flexi@localhost:5433/flexi (matches docker-compose)
DATABASE_URL=postgres://flexi:flexi@localhost:5433/flexi
# [OPTIONAL] Max database connections (Default: 10)
DATABASE_MAX_CONNECTIONS=10

# [REQUIRED] Redis connection string for Caching/Idempotency
# Default for dev: redis://localhost:6380 (matches docker-compose)
REDIS_URL=redis://localhost:6380

# === Auth (PASETO v4) ===

# [REQUIRED] Secret key for token signing (used by Auth service)
PASETO_SECRET_KEY=your-secret-key-here
# [REQUIRED] Base64URL (no padding) encoded Ed25519 public key for v4.public verification
# Use for kernel-api to verify tokens from Auth service.
FLEXI_PASETO_V4_PUBLIC_KEY_B64URL=
# [OPTIONAL] Token expiry in seconds (Default: 900 / 604800)
ACCESS_TOKEN_EXPIRY_SECS=900
REFRESH_TOKEN_EXPIRY_SECS=604800

# === Server ===

# [OPTIONAL] Server binding address (Default: 127.0.0.1)
KERNEL_API_HOST=127.0.0.1
# [OPTIONAL] Server port (Default: 3000)
KERNEL_API_PORT=3000
# [OPTIONAL] Logging level (Default: info)
RUST_LOG=info,kernel=debug

# === Middleware Configuration (Optional, defaults as shown) ===

# Time-To-Live for Idempotency records (Default: 86400s / 24h)
IDEMPOTENCY_TTL_SECS=86400
# Time-To-Live for Action records (Default: 86400s / 24h)
ACTION_TTL_SECS=86400
# Max request body size for buffering (Default: 10MB)
MAX_BODY_SIZE_BYTES=10485760
# Max response body size for replay cache (Default: 10MB)
MAX_REPLAY_BODY_SIZE_BYTES=10485760
# Timeout for waiting on concurrent in-flight requests (Default: 5s)
INFLIGHT_WAIT_TIMEOUT_SECS=5

# === Storage (S3/MinIO) ===

# [REQUIRED] S3 endpoint URL
S3_ENDPOINT=http://localhost:9000
# [REQUIRED] S3 bucket name
S3_BUCKET=flexisuite-components
# [REQUIRED] S3 credentials
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# === Component Builder ===

# [OPTIONAL] URL for ESM CDN (Default: https://esm.sh)
ESM_CDN_URL=https://esm.sh
